<Window x:Class="Zeiterfassung.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Version – Zeiterfassung"
        Language="de-DE"
        Width="420"
        Height="240"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Zeiterfassung" Style="{StaticResource Heading}" Margin="0,0,0,4" />
        <TextBlock x:Name="VersionText" Grid.Row="1" FontSize="14" Margin="0,0,0,8" />
        <TextBlock Grid.Row="2" Style="{StaticResource Muted}" TextWrapping="Wrap"
                   Text="Zeiterfassung für Arbeitszeit, Abwesenheiten und Monatsübersicht." />

        <Button Grid.Row="3" Content="Schließen" IsCancel="True" IsDefault="True"
                HorizontalAlignment="Right" Margin="0" />
    </Grid>
</Window>
