<UserControl x:Class="Zeiterfassung.Views.ErfassungView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Zeiterfassung.Views">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Formular -->
        <Border Style="{StaticResource Card}" Margin="0,0,16,0">
            <StackPanel>
                <TextBlock Text="{Binding FormTitle}" Style="{StaticResource Heading}" />

                <TextBlock Text="Datum" Style="{StaticResource Muted}" />
                <views:DateField SelectedDate="{Binding SelectedDate}" />

                <TextBlock Text="Kunde" Style="{StaticResource Muted}" />
                <ItemsControl ItemsSource="{Binding CustomerPicks}" Margin="0,0,0,10">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding Name}"
                                    Command="{Binding DataContext.SelectCustomerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding Id}"
                                    Padding="12,8"
                                    MinWidth="0"
                                    Margin="0,0,6,6">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource ChipButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="BorderBrush" Value="{StaticResource BrushAccent}" />
                                                <Setter Property="Background" Value="#0C4A6E" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel Orientation="Horizontal">
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="Start (HH:mm)" Style="{StaticResource Muted}" />
                        <TextBox Width="90" MinWidth="0" MaxLength="5" TextAlignment="Center"
                                 Text="{Binding StartText, UpdateSourceTrigger=PropertyChanged}"
                                 PreviewTextInput="TimeInput_PreviewTextInput"
                                 DataObject.Pasting="TimeInput_Pasting" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Ende (HH:mm)" Style="{StaticResource Muted}" />
                        <TextBox Width="90" MinWidth="0" MaxLength="5" TextAlignment="Center"
                                 Text="{Binding EndText, UpdateSourceTrigger=PropertyChanged}"
                                 PreviewTextInput="TimeInput_PreviewTextInput"
                                 DataObject.Pasting="TimeInput_Pasting" />
                    </StackPanel>
                </StackPanel>

                <TextBlock Text="Pause (Minuten)" Style="{StaticResource Muted}" />
                <TextBox Text="{Binding BreakText, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Text="Notiz" Style="{StaticResource Muted}" />
                <TextBox Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" />

                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <Button Content="Speichern" Style="{StaticResource AccentButton}" Command="{Binding SaveCommand}" />
                    <Button Content="Neu" Command="{Binding NewEntryCommand}" />
                </StackPanel>

                <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}" />

                <!-- Pause ohne Kundenbezug -->
                <TextBlock Text="Pause (ohne Kunde)" Style="{StaticResource Heading}" FontSize="14" Margin="0,18,0,8" />
                <StackPanel Orientation="Horizontal">
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="Beginn (HH:mm)" Style="{StaticResource Muted}" />
                        <TextBox Width="90" MinWidth="0" MaxLength="5" TextAlignment="Center"
                                 Text="{Binding PauseStartText, UpdateSourceTrigger=PropertyChanged}"
                                 PreviewTextInput="TimeInput_PreviewTextInput"
                                 DataObject.Pasting="TimeInput_Pasting" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Ende (HH:mm)" Style="{StaticResource Muted}" />
                        <TextBox Width="90" MinWidth="0" MaxLength="5" TextAlignment="Center"
                                 Text="{Binding PauseEndText, UpdateSourceTrigger=PropertyChanged}"
                                 PreviewTextInput="TimeInput_PreviewTextInput"
                                 DataObject.Pasting="TimeInput_Pasting" />
                    </StackPanel>
                </StackPanel>
                <Button Content="Pause eintragen" Style="{StaticResource AccentButton}"
                        Command="{Binding AddPauseCommand}" HorizontalAlignment="Left" />
                <TextBlock Text="{Binding PauseError}" Style="{StaticResource ErrorText}" />
            </StackPanel>
        </Border>

        <!-- Buchungen des gewählten Tages -->
        <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Buchungen am gewählten Tag" Style="{StaticResource Heading}" FontSize="14" />

                <!-- Pausen des Tages, unter den Buchungen -->
                <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                    <TextBlock Text="Pausen am gewählten Tag" Style="{StaticResource Muted}" />
                    <ItemsControl ItemsSource="{Binding Pauses}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource ListRowBorder}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="70" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock VerticalAlignment="Center">
                                            <Run Text="{Binding Start, Mode=OneWay}" />
                                            <Run Text=" – " />
                                            <Run Text="{Binding End, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock Grid.Column="1" Text="Pause" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{Binding Duration}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0" />
                                        <Button Grid.Column="3" Content="Löschen" Margin="0" VerticalAlignment="Center"
                                                Command="{Binding DataContext.DeletePauseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Entries}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource ListRowBorder}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="70" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Start}" />
                                            <TextBlock Text=" – " />
                                            <TextBlock Text="{Binding End}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Customer}" />
                                            <TextBlock Text="{Binding Note}" Style="{StaticResource Muted}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding Duration}" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0" />
                                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="Bearbeiten"
                                                    Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="Löschen"
                                                    Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
