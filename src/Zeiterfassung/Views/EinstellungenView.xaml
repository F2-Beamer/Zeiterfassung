<UserControl x:Class="Zeiterfassung.Views.EinstellungenView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Zeiterfassung.Views">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}" Margin="0,0,0,12" />

            <UniformGrid Columns="2">

                <!-- Kunden -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Kunden" Style="{StaticResource Heading}" FontSize="16" />
                        <ListBox ItemsSource="{Binding Customers}" SelectedItem="{Binding SelectedCustomer}"
                                 DisplayMemberPath="DisplayName" MaxHeight="150" Margin="0,0,0,10" />
                        <StackPanel Orientation="Horizontal">
                            <TextBox Text="{Binding NewCustomerName, UpdateSourceTrigger=PropertyChanged}" Width="200" />
                            <Button Content="Hinzufügen" Command="{Binding AddCustomerCommand}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBox Text="{Binding RenameText, UpdateSourceTrigger=PropertyChanged}" Width="200" />
                            <Button Content="Umbenennen" Command="{Binding RenameCustomerCommand}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Archivieren / Reaktivieren" Command="{Binding ToggleArchiveCommand}" CommandParameter="{Binding SelectedCustomer}" />
                            <Button Content="Löschen" Command="{Binding DeleteCustomerCommand}" CommandParameter="{Binding SelectedCustomer}" />
                        </StackPanel>
                        <TextBlock Text="Löschen ist nur ohne Buchungen möglich. Sonst bitte archivieren." Style="{StaticResource Muted}" />
                    </StackPanel>
                </Border>

                <!-- Soll-Arbeitszeit -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Soll-Arbeitszeit" Style="{StaticResource Heading}" FontSize="16" />
                        <ItemsControl ItemsSource="{Binding Profiles}" MaxHeight="120">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding ValidFrom, StringFormat='ab {0}'}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding WeeklyHours, StringFormat='{}{0} h/Woche'}" VerticalAlignment="Center" />
                                        <Button Grid.Column="2" Content="Bearbeiten"
                                                Command="{Binding DataContext.EditProfileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                        <Button Grid.Column="3" Content="Löschen"
                                                Command="{Binding DataContext.DeleteProfileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="Gültig ab" Style="{StaticResource Muted}" />
                        <views:DateField SelectedDate="{Binding ProfileValidFrom}" />
                        <TextBlock Text="Wochenstunden (z. B. 40 oder 38:30)" Style="{StaticResource Muted}" />
                        <TextBox Text="{Binding ProfileWeeklyHours, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Text="Feste Tagesstunden (leer = verteilt auf Mo–Fr)" Style="{StaticResource Muted}" />
                        <UniformGrid Columns="4">
                            <StackPanel><TextBlock Text="Mo" Style="{StaticResource Muted}" /><TextBox Text="{Binding OverrideMonday, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                            <StackPanel><TextBlock Text="Di" Style="{StaticResource Muted}" /><TextBox Text="{Binding OverrideTuesday, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                            <StackPanel><TextBlock Text="Mi" Style="{StaticResource Muted}" /><TextBox Text="{Binding OverrideWednesday, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                            <StackPanel><TextBlock Text="Do" Style="{StaticResource Muted}" /><TextBox Text="{Binding OverrideThursday, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                            <StackPanel><TextBlock Text="Fr" Style="{StaticResource Muted}" /><TextBox Text="{Binding OverrideFriday, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                            <StackPanel><TextBlock Text="Sa" Style="{StaticResource Muted}" /><TextBox Text="{Binding OverrideSaturday, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                            <StackPanel><TextBlock Text="So" Style="{StaticResource Muted}" /><TextBox Text="{Binding OverrideSunday, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                        </UniformGrid>

                        <StackPanel Orientation="Horizontal">
                            <Button Content="Speichern" Style="{StaticResource AccentButton}" Command="{Binding SaveProfileCommand}" />
                            <Button Content="Neu" Command="{Binding NewProfileCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Urlaub -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Urlaubskonto" Style="{StaticResource Heading}" FontSize="16" />
                        <StackPanel Orientation="Horizontal">
                            <TextBox Text="{Binding VacationYear}" Width="90" />
                            <Button Content="Jahr laden" Command="{Binding VacationYearChangedCommand}" />
                        </StackPanel>
                        <TextBlock Text="Anspruch in Tagen" Style="{StaticResource Muted}" />
                        <TextBox Text="{Binding VacationDays, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="Korrektur in Tagen (optional)" Style="{StaticResource Muted}" />
                        <TextBox Text="{Binding VacationCorrection, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="Manueller Startwert Übertrag (nur Einstieg, optional)" Style="{StaticResource Muted}" />
                        <TextBox Text="{Binding VacationOpening, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Content="Speichern" Style="{StaticResource AccentButton}" Command="{Binding SaveVacationCommand}" HorizontalAlignment="Left" />
                        <TextBlock Text="{Binding VacationStatusText}" Style="{StaticResource Muted}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- Überstunden-Startsaldo -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Überstunden-Startsaldo" Style="{StaticResource Heading}" FontSize="16" />
                        <TextBlock Text="Stichtag" Style="{StaticResource Muted}" />
                        <views:DateField SelectedDate="{Binding OvertimeAsOf}" />
                        <TextBlock Text="Saldo am Stichtag (z. B. +12:30 oder -3,5)" Style="{StaticResource Muted}" />
                        <TextBox Text="{Binding OvertimeHours, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Content="Speichern" Style="{StaticResource AccentButton}" Command="{Binding SaveOvertimeOpeningCommand}" HorizontalAlignment="Left" />
                        <TextBlock Text="{Binding OvertimeStatusText}" Style="{StaticResource Muted}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- Bundesland und Feiertage -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Bundesland und Feiertage" Style="{StaticResource Heading}" FontSize="16" />
                        <TextBlock Text="Bundesland" Style="{StaticResource Muted}" />
                        <StackPanel Orientation="Horizontal">
                            <ListBox ItemsSource="{Binding FederalStates}"
                                     SelectedItem="{Binding SelectedFederalState}"
                                     DisplayMemberPath="Name"
                                     Width="220"
                                     MaxHeight="160"
                                     VerticalAlignment="Top"
                                     Margin="0,0,12,10" />
                            <Button Content="Übernehmen" Command="{Binding SaveFederalStateCommand}" VerticalAlignment="Top" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBox Text="{Binding HolidayYear}" Width="90" />
                            <Button Content="Jahr anzeigen" Command="{Binding HolidayYearChangedCommand}" />
                            <Button Content="Feiertage abrufen" Style="{StaticResource AccentButton}" Command="{Binding RefreshHolidaysCommand}" />
                        </StackPanel>
                        <TextBlock Text="{Binding HolidayStatusText}" Style="{StaticResource Muted}" TextWrapping="Wrap" />
                        <ItemsControl ItemsSource="{Binding HolidayRows}" MaxHeight="150">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Date}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Backup -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Datensicherung" Style="{StaticResource Heading}" FontSize="16" />
                        <CheckBox Content="Beim Start automatisch sichern (letzte 10 behalten)"
                                  IsChecked="{Binding AutoBackupOnStart}" />
                        <Button Content="Jetzt sichern" Command="{Binding CreateBackupCommand}" HorizontalAlignment="Left" />
                        <TextBlock Text="Sicherungen" Style="{StaticResource Muted}" />
                        <ListBox ItemsSource="{Binding BackupFiles}" SelectedItem="{Binding SelectedBackupFile}" MaxHeight="150" />
                        <Button Content="Ausgewählte Sicherung wiederherstellen" Command="{Binding RestoreBackupCommand}" HorizontalAlignment="Left" />
                        <TextBlock Text="{Binding BackupStatusText}" Style="{StaticResource Muted}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

            </UniformGrid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
