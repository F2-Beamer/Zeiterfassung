<Window x:Class="Zeiterfassung.Views.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Anleitung – Zeiterfassung"
        Language="de-DE"
        Width="720"
        Height="700"
        MinWidth="520"
        MinHeight="420"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Anleitung" Style="{StaticResource Heading}" />

                <TextBlock Text="Überblick" Style="{StaticResource Heading}" FontSize="16" />
                <TextBlock TextWrapping="Wrap" Margin="0,0,0,12"
                           Text="Die Zeiterfassung hat drei Bereiche, die oben in der Leiste ausgewählt werden: Heute, Monat und Einstellungen. Unter Hilfe findest du diese Anleitung und die Versionsnummer des Programms." />

                <TextBlock Text="Heute" Style="{StaticResource Heading}" FontSize="16" />
                <TextBlock TextWrapping="Wrap" Margin="0,0,0,6"
                           Text="Timer: Klicke auf eine Kundenkachel, um die Zeit für diesen Kunden zu starten. Mit Pause und Fortsetzen unterbrichst du den Timer. Mit Stopp wird die Buchung gespeichert. Läuft der Timer für einen anderen Kunden, wechselt die Kachel den Kunden. Timer unter einer Minute werden verworfen." />
                <TextBlock TextWrapping="Wrap" Margin="0,0,0,6"
                           Text="Manuelle Buchung: Trage Start und Ende im Format HH:mm ein (z. B. 08:00), wähle den Kunden und speichere. Die Pause in Minuten kann zusätzlich angegeben werden. Mit Bearbeiten und Löschen änderst du bestehende Buchungen des Tages." />
                <TextBlock TextWrapping="Wrap" Margin="0,0,0,12"
                           Text="Pause ohne Kunde: Unter „Pause (ohne Kunde)“ trägst du Beginn und Ende einer Pause ein. Sie wird unabhängig von einem Kunden von der Ist-Zeit des Tages abgezogen. Überschneidende Pausen werden abgelehnt." />

                <TextBlock Text="Monat" Style="{StaticResource Heading}" FontSize="16" />
                <TextBlock TextWrapping="Wrap" Margin="0,0,0,6"
                           Text="Jeder Tag steht in einer Zeile mit Soll, Ist und Saldo. In der Spalte Hinweis siehst du Abwesenheiten und die Stunden je Kunde an diesem Tag." />
                <TextBlock TextWrapping="Wrap" Margin="0,0,0,12"
                           Text="Mit Details öffnet sich der Tag: Dort siehst du alle Buchungen mit Zeit, Kunde, Pause und Netto sowie die Pausen. Außerdem trägst du dort Abwesenheiten für diesen Tag ein oder löschst sie." />

                <TextBlock Text="Abwesenheiten" Style="{StaticResource Heading}" FontSize="16" />
                <TextBlock TextWrapping="Wrap" Margin="0,0,0,6"
                           Text="Arten: Urlaub, Krank und Freizeitausgleich. Der Umfang ist ganzer Tag (1) oder halber Tag (0,5)." />
                <TextBlock TextWrapping="Wrap" Margin="0,0,0,6"
                           Text="Pro Tag ist nur eine Abwesenheit erlaubt. Einzige Ausnahme: halber Urlaub zusammen mit halbem Freizeitausgleich." />
                <TextBlock TextWrapping="Wrap" Margin="0,0,0,6"
                           Text="An einem Tag mit ganzem Urlaub oder ganz krank kann nicht gearbeitet und nicht pausiert werden." />
                <TextBlock TextWrapping="Wrap" Margin="0,0,0,12"
                           Text="Halber Urlaub, halb krank und Freizeitausgleich können zusammen mit Arbeitszeit an demselben Tag stehen." />

                <TextBlock Text="Einstellungen" Style="{StaticResource Heading}" FontSize="16" />
                <TextBlock TextWrapping="Wrap" Margin="0,0,0,6"
                           Text="Kunden: Lege Kunden an, benenne sie um oder archiviere sie. Gelöscht werden kann ein Kunde nur, wenn er keine Buchungen hat. Sonst bitte archivieren." />
                <TextBlock TextWrapping="Wrap" Margin="0,0,0,6"
                           Text="Soll-Arbeitszeit: Hinterlege Wochenstunden oder feste Tagesstunden, jeweils mit einem Gültig-ab-Datum. Ändert sich deine Arbeitszeit, lege ein neues Profil an." />
                <TextBlock TextWrapping="Wrap" Margin="0,0,0,6"
                           Text="Urlaubskonto: Trage den Urlaubsanspruch je Jahr ein. Optional kannst du eine Korrektur und einen Übertrag aus dem Vorjahr angeben." />
                <TextBlock TextWrapping="Wrap" Margin="0,0,0,6"
                           Text="Bundesland und Feiertage: Wähle dein Bundesland, damit die gesetzlichen Feiertage berücksichtigt werden." />
                <TextBlock TextWrapping="Wrap" Margin="0,0,0,6"
                           Text="Überstunden-Startsaldo: Trage den Überstundenstand zu einem Stichtag ein, um am Anfang der Nutzung den bisherigen Saldo zu übernehmen." />
                <TextBlock TextWrapping="Wrap" Margin="0,0,0,12"
                           Text="Datensicherung: Sicherungen können beim Start automatisch erstellt, manuell angelegt und wiederhergestellt werden." />
            </StackPanel>
        </ScrollViewer>

        <Button Grid.Row="1" Content="Schließen" IsCancel="True" IsDefault="True"
                HorizontalAlignment="Right" Margin="0,12,0,0" />
    </Grid>
</Window>
