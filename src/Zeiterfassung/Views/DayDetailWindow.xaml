<Window x:Class="Zeiterfassung.Views.DayDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tagesdetails"
        Language="de-DE"
        Width="640"
        Height="680"
        MinWidth="520"
        MinHeight="480"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Kopf: Datum und Tagessummen -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="{Binding Title}" Style="{StaticResource Heading}" Margin="0,0,0,4" />
            <TextBlock Text="{Binding Summary}" Style="{StaticResource Muted}" FontSize="13" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- Buchungen -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Buchungen" Style="{StaticResource Heading}" FontSize="16" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="70" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Zeit" Style="{StaticResource Muted}" />
                            <TextBlock Grid.Column="1" Text="Kunde" Style="{StaticResource Muted}" />
                            <TextBlock Grid.Column="2" Text="Pause" Style="{StaticResource Muted}" HorizontalAlignment="Right" />
                            <TextBlock Grid.Column="3" Text="Netto" Style="{StaticResource Muted}" HorizontalAlignment="Right" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Bookings}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource ListRowBorder}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="150" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="70" />
                                                <ColumnDefinition Width="70" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Time}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                                <Run Text="{Binding Customer, Mode=OneWay}" />
                                                <Run Text="{Binding NoteSuffix, Mode=OneWay}" Foreground="{StaticResource BrushTextMuted}" FontSize="12" />
                                            </TextBlock>
                                            <TextBlock Grid.Column="2" Text="{Binding Break}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="3" Text="{Binding Net}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="Keine Buchungen an diesem Tag." Style="{StaticResource Muted}" Margin="0,8,0,0"
                                   Visibility="{Binding NoBookings, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </Border>

                <!-- Abwesenheiten des Tages -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Abwesenheit" Style="{StaticResource Heading}" FontSize="16" />
                        <ItemsControl ItemsSource="{Binding Absences}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource ListRowBorder}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="150" />
                                                <ColumnDefinition Width="70" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Type}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding Portion}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="{Binding Note}" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                                            <Button Grid.Column="3" Content="Löschen" Margin="0" VerticalAlignment="Center"
                                                    Command="{Binding DataContext.DeleteAbsenceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="Keine Abwesenheit an diesem Tag." Style="{StaticResource Muted}" Margin="0,8,0,0"
                                   Visibility="{Binding NoAbsences, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </Border>

                <!-- Neue Abwesenheit für diesen Tag -->
                <Border Style="{StaticResource Card}" Margin="0">
                    <StackPanel>
                        <TextBlock Text="Abwesenheit für diesen Tag eintragen" Style="{StaticResource Heading}" FontSize="16" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Art" Style="{StaticResource Muted}" />
                                <ListBox ItemsSource="{Binding TypeOptions}"
                                         SelectedItem="{Binding NewType}"
                                         DisplayMemberPath="Label"
                                         MaxHeight="120"
                                         Margin="0,0,0,10" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Umfang (1 = ganzer Tag, 0,5 = halber Tag)" Style="{StaticResource Muted}" />
                                <ListBox ItemsSource="{Binding PortionOptions}"
                                         SelectedItem="{Binding NewPortion}"
                                         MaxHeight="80"
                                         Margin="0,0,0,10" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="Notiz" Style="{StaticResource Muted}" />
                        <TextBox Text="{Binding NewNote, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Content="Eintragen" Style="{StaticResource AccentButton}"
                                Command="{Binding AddAbsenceCommand}" HorizontalAlignment="Left" />
                        <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Fuß -->
        <Button Grid.Row="2" Content="Schließen" IsCancel="True" IsDefault="True"
                HorizontalAlignment="Right" Margin="0,12,0,0" />
    </Grid>
</Window>
