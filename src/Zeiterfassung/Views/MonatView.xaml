<UserControl x:Class="Zeiterfassung.Views.MonatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Zeiterfassung.ViewModels">

    <UserControl.Resources>
        <!-- Tag als Textlink: ohne Rahmen und Knopfoptik, Hover und Fokus in der Akzentfarbe -->
        <Style x:Key="DayLink" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Foreground" Value="{StaticResource BrushText}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource BrushAccent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BalanceFigure" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Georgia" />
            <Setter Property="FontSize" Value="48" />
            <Setter Property="Foreground" Value="{StaticResource BrushTextStrong}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding BalanceSumTone}" Value="{x:Static vm:Tone.Positive}">
                    <Setter Property="Foreground" Value="{StaticResource BrushSuccess}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding BalanceSumTone}" Value="{x:Static vm:Tone.Negative}">
                    <Setter Property="Foreground" Value="{StaticResource BrushDanger}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <DockPanel>
        <!-- Monatsnavigation -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <Button Content="Zurück" Command="{Binding PreviousMonthCommand}" Padding="12,4" />
                <TextBlock Text="{Binding MonthTitle}" FontFamily="Georgia" FontSize="32" Foreground="{StaticResource BrushTextStrong}" Margin="12,0,12,0" VerticalAlignment="Center" />
                <Button Content="Weiter" Command="{Binding NextMonthCommand}" Padding="12,4" />
            </StackPanel>
        </DockPanel>

        <!-- Zusammenfassung: ein Satz, der Saldo als große Zahl, eine Zeile mit den Nebenwerten -->
        <StackPanel DockPanel.Dock="Top" Margin="0,8,0,16">
            <TextBlock Text="{Binding SummaryText}" FontSize="20" TextWrapping="Wrap" Margin="0,0,0,16" />
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding BalanceSum}" Style="{StaticResource BalanceFigure}" />
                <TextBlock Text="Saldo Monat" Style="{StaticResource Muted}" FontSize="14" VerticalAlignment="Bottom" Margin="16,0,0,12" />
            </StackPanel>
            <TextBlock Text="{Binding DetailLine}" Style="{StaticResource Muted}" FontSize="14" Margin="0,8,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <!-- Tabelle: eine Zeile je Tag, ein Klick auf den Tag öffnet seine Buchungen und Abwesenheiten -->
        <Border Style="{StaticResource Card}" Margin="0">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="100" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Tag" Style="{StaticResource Muted}" />
                    <TextBlock Grid.Column="1" Text="Hinweis" Style="{StaticResource Muted}" />
                    <TextBlock Grid.Column="2" Text="Ist" Style="{StaticResource Muted}" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="3" Text="Soll" Style="{StaticResource Muted}" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="4" Text="Saldo" Style="{StaticResource Muted}" HorizontalAlignment="Right" />
                </Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Days}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource ListRowBorder}" Padding="0,7">
                                    <Grid>
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsFuture}" Value="True">
                                                        <Setter Property="Opacity" Value="0.4" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="100" />
                                        </Grid.ColumnDefinitions>
                                        <Button Content="{Binding DateText}"
                                                Command="{Binding DataContext.OpenDayCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource DayLink}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                            <Setter Property="FontWeight" Value="Bold" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <TextBlock Grid.Column="1" Text="{Binding Note}" Foreground="{StaticResource BrushTextMuted}" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />
                                        <TextBlock Grid.Column="2" Text="{Binding Actual}" HorizontalAlignment="Right" />
                                        <TextBlock Grid.Column="3" Text="{Binding Target}" HorizontalAlignment="Right" />
                                        <TextBlock Grid.Column="4" Text="{Binding Balance}" HorizontalAlignment="Right">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding BalanceTone}" Value="{x:Static vm:Tone.Positive}">
                                                            <Setter Property="Foreground" Value="{StaticResource BrushSuccess}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding BalanceTone}" Value="{x:Static vm:Tone.Negative}">
                                                            <Setter Property="Foreground" Value="{StaticResource BrushDanger}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </DockPanel>
</UserControl>
